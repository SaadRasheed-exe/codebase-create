# Copy to .env and fill in values for the backends you use.

# NVIDIA-hosted OpenAI-compatible endpoint
nvidia_api_key=

# Other providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Base URL overrides (for local Ollama or OpenAI-compatible endpoints)
OLLAMA_BASE_URL=http://localhost:11434/v1
#OPENAI_BASE_URL=

# Agent configuration (all optional — defaults shown)
#AGENT_BACKEND=mock
#AGENT_MODEL=google/gemma-2-2b-it
#AGENT_TEST_TIMEOUT=15
#AGENT_KEEP_ARTIFACTS=false
#AGENT_GENERATION_TEMPERATURE=0.1
#AGENT_SANDBOX=subprocess
#AGENT_MOCK_SCENARIO=happy_path
#AGENT_MAX_TOKENS=4096
#AGENT_MAX_TURNS=12
#AGENT_DOCKER_IMAGE=python:3.11-slim
#AGENT_DOCKER_NETWORK_DISABLED=true
#AGENT_DOCKER_MEMORY=512m
#AGENT_DOCKER_CPUS=1.0
