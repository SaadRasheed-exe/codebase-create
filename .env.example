# Copy to .env and fill in values for the backends you use.

# NVIDIA-hosted OpenAI-compatible endpoint (default backend)
nvidia_api_key=

# Native provider SDKs (added in upcoming phases)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent configuration overrides (all optional)
#AGENT_BACKEND=openai
#AGENT_MODEL=google/gemma-2-2b-it
#AGENT_TEST_TIMEOUT=15
#AGENT_MAX_ITERATIONS=8
#AGENT_KEEP_ARTIFACTS=false
#AGENT_GENERATION_TEMPERATURE=0.1
#AGENT_SANDBOX=docker
#AGENT_DOCKER_IMAGE=python:3.11-slim
#AGENT_DOCKER_NETWORK_DISABLED=true
#AGENT_DOCKER_MEMORY=512m
#AGENT_DOCKER_CPUS=1.0
